---
import Integrations from '../../components/pages/Integrations.astro';
import { DEFAULT_LOCALE, PAGE_LOCALES, type Locale } from '../../i18n/config';

export function getStaticPaths() {
  return PAGE_LOCALES['/integrations']
    .filter((lang) => lang !== DEFAULT_LOCALE)
    .map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
---
<Integrations lang={lang} />
