---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, SITE_NAME, APP_STORE_ID } from '../consts';

interface Props {
  title: string;
  description: string;
  /** Canonical path, e.g. "/" or "/privacy" */
  path: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  screenLabel?: string;
  /** Extra stylesheets loaded after site.css, in order */
  css?: string[];
  /** Extra deferred scripts loaded after site.js */
  js?: string[];
  /** e.g. "noindex, follow" — also suppresses hreflang alternates */
  robots?: string;
}

const {
  title,
  description,
  path,
  ogTitle = title,
  ogDescription = description,
  ogType = 'website',
  screenLabel,
  css = [],
  js = [],
  robots,
} = Astro.props;

const canonical = SITE + path;
const ogImage = `${SITE}/assets/og-image.png`;
---
<!DOCTYPE html>
<html lang={Astro.currentLocale ?? 'en'}>
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
{robots && <meta name="robots" content={robots} />}
<link rel="canonical" href={canonical} />
{!robots && <link rel="alternate" hreflang="en" href={canonical} />}
{!robots && <link rel="alternate" hreflang="x-default" href={canonical} />}
<meta name="apple-itunes-app" content={`app-id=${APP_STORE_ID}`} />
<meta name="theme-color" content="#0a0a14" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={ogDescription} />
<meta property="og:image" content={ogImage} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogImage} />
<link rel="icon" type="image/svg+xml" href="/assets/manilo-icon.svg" />
<link rel="apple-touch-icon" href="/assets/manilo-icon.svg" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
<link rel="stylesheet" href="/assets/site.css" />
{css.map((href) => <link rel="stylesheet" href={href} />)}
<slot name="head" />
<script src="/assets/analytics.js" defer is:inline></script>
</head>
<body data-screen-label={screenLabel}>
<a href="#main" class="skip-link">Skip to content</a>
<div class="starfield" aria-hidden="true"></div>

<Header />

<main id="main">
<slot />
</main>

<Footer />

<script src="/assets/site.js" defer is:inline></script>
{js.map((src) => <script src={src} defer is:inline></script>)}
</body>
</html>
