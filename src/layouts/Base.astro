---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, SITE_NAME, APP_STORE_ID } from '../consts';
import { PAGE_LOCALES, DEFAULT_LOCALE, localeUrl, navUrl, BANNER_MESSAGES, type Locale } from '../i18n/config';
import { getDict } from '../i18n';

interface Props {
  title: string;
  description: string;
  /** Logical page path, e.g. "/" or "/privacy" — locale prefix is added automatically */
  path: string;
  locale?: Locale;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  screenLabel?: string;
  /** Extra stylesheets loaded after site.css, in order */
  css?: string[];
  /** Extra deferred scripts loaded after site.js */
  js?: string[];
  /** e.g. "noindex, follow" — also suppresses hreflang alternates */
  robots?: string;
}

const {
  title,
  description,
  path,
  locale = DEFAULT_LOCALE,
  ogTitle = title,
  ogDescription = description,
  ogType = 'website',
  screenLabel,
  css = [],
  js = [],
  robots,
} = Astro.props;

const chrome = getDict<{ skipLink: string; cookies?: { text: string; accept: string; decline: string; privacy: string } }>(locale, 'chrome');
const cookieData = JSON.stringify({ ...(chrome.cookies ?? getDict<{ cookies: object }>(DEFAULT_LOCALE, 'chrome').cookies), privacyUrl: navUrl(locale, '/privacy') });
const canonical = SITE + localeUrl(locale, path);
const ogImage = `${SITE}/assets/og-image.png`;
const pageLocales = PAGE_LOCALES[path] ?? [DEFAULT_LOCALE];

const bannerData =
  pageLocales.length > 1
    ? JSON.stringify({
        current: locale,
        urls: Object.fromEntries(pageLocales.map((l) => [l, localeUrl(l, path)])),
        messages: Object.fromEntries(pageLocales.map((l) => [l, BANNER_MESSAGES[l]])),
      })
    : null;
---
<!DOCTYPE html>
<html lang={locale}>
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
{robots && <meta name="robots" content={robots} />}
<link rel="canonical" href={canonical} />
{!robots && pageLocales.map((l) => <link rel="alternate" hreflang={l} href={SITE + localeUrl(l, path)} />)}
{!robots && <link rel="alternate" hreflang="x-default" href={SITE + localeUrl(DEFAULT_LOCALE, path)} />}
<meta name="apple-itunes-app" content={`app-id=${APP_STORE_ID}`} />
<meta name="theme-color" content="#0a0a14" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={ogDescription} />
<meta property="og:image" content={ogImage} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogImage} />
<link rel="icon" type="image/svg+xml" href="/assets/manilo-icon.svg" />
<link rel="apple-touch-icon" href="/assets/manilo-icon.svg" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
<link rel="stylesheet" href="/assets/site.css" />
{css.map((href) => <link rel="stylesheet" href={href} />)}
<slot name="head" />
<script src="/assets/analytics.js" defer is:inline></script>
</head>
<body data-screen-label={screenLabel}>
<a href="#main" class="skip-link">{chrome.skipLink}</a>
<div class="starfield" aria-hidden="true"></div>

<Header locale={locale} path={path} />

<main id="main">
<slot />
</main>

<Footer locale={locale} path={path} />

<script src="/assets/site.js" defer is:inline></script>
{js.map((src) => <script src={src} defer is:inline></script>)}
<script is:inline data-i18n={cookieData}>
(function () {
  try {
    var KEY = 'manilo-cookie-consent';
    if (localStorage.getItem(KEY)) return;
    var d = JSON.parse(document.currentScript.dataset.i18n);
    var bar = document.createElement('div');
    bar.setAttribute('role', 'dialog');
    bar.setAttribute('aria-live', 'polite');
    bar.setAttribute('style', 'position:fixed;left:16px;right:16px;bottom:16px;z-index:1001;margin:0 auto;max-width:640px;display:flex;flex-wrap:wrap;align-items:center;gap:12px 16px;padding:14px 18px;border-radius:16px;background:rgba(18,16,38,0.96);border:1px solid rgba(123,98,255,0.45);box-shadow:0 8px 32px rgba(0,0,0,0.5);font-size:14px;color:#E8EBF0;line-height:1.45;');
    var p = document.createElement('p');
    p.setAttribute('style', 'margin:0;flex:1 1 280px;');
    p.textContent = d.text + ' ';
    var a = document.createElement('a');
    a.href = d.privacyUrl; a.textContent = d.privacy;
    a.setAttribute('style', 'color:#9C96F6;text-decoration:underline;');
    p.appendChild(a);
    var box = document.createElement('div');
    box.setAttribute('style', 'display:flex;gap:8px;margin-left:auto;');
    function btn(label, value, primary) {
      var b = document.createElement('button');
      b.type = 'button'; b.textContent = label;
      b.setAttribute('style', 'cursor:pointer;border-radius:999px;padding:8px 16px;font-size:14px;font-weight:600;border:1px solid ' + (primary ? '#6042FE;background:#6042FE;color:#fff;' : 'rgba(255,255,255,0.2);background:transparent;color:#E8EBF0;'));
      b.addEventListener('click', function () {
        try { localStorage.setItem(KEY, value); } catch (e) {}
        window.dispatchEvent(new CustomEvent('manilo-cookie-consent', { detail: value }));
        bar.remove();
      });
      return b;
    }
    box.appendChild(btn(d.decline, 'denied', false));
    box.appendChild(btn(d.accept, 'granted', true));
    bar.appendChild(p); bar.appendChild(box);
    document.body.appendChild(bar);
  } catch (e) {}
})();
</script>
{bannerData && (
  <script is:inline data-i18n={bannerData}>
(function () {
  try {
    var KEY = 'manilo-lang-banner-off';
    if (localStorage.getItem(KEY)) return;
    var data = JSON.parse(document.currentScript.dataset.i18n);
    var prefs = (navigator.languages || [navigator.language || 'en']).map(function (l) {
      return String(l).slice(0, 2).toLowerCase();
    });
    var target = null;
    for (var i = 0; i < prefs.length; i++) {
      if (prefs[i] === data.current) break;
      if (data.urls[prefs[i]]) { target = prefs[i]; break; }
    }
    if (!target) return;
    var bar = document.createElement('div');
    bar.setAttribute('style', 'position:fixed;left:50%;bottom:16px;transform:translateX(-50%);z-index:1000;display:flex;align-items:center;gap:12px;padding:10px 18px;border-radius:999px;background:rgba(18,16,38,0.94);border:1px solid rgba(123,98,255,0.45);box-shadow:0 8px 32px rgba(0,0,0,0.5);font-size:14px;max-width:calc(100vw - 32px);');
    var a = document.createElement('a');
    a.href = data.urls[target];
    a.textContent = data.messages[target];
    a.setAttribute('style', 'color:#E8EBF0;text-decoration:none;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;');
    var x = document.createElement('button');
    x.textContent = '✕';
    x.setAttribute('aria-label', 'Dismiss');
    x.setAttribute('style', 'background:none;border:none;color:#9C96F6;cursor:pointer;font-size:14px;padding:2px;line-height:1;');
    x.addEventListener('click', function () {
      try { localStorage.setItem(KEY, '1'); } catch (e) {}
      bar.remove();
    });
    bar.appendChild(a);
    bar.appendChild(x);
    document.body.appendChild(bar);
  } catch (e) {}
})();
  </script>
)}
</body>
</html>
