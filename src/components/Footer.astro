---
import { APP_STORE_URL, DASHBOARD_URL, SUPPORT_EMAIL } from '../consts';
import { DEFAULT_LOCALE, PAGE_LOCALES, LOCALE_NAMES, localeUrl, navUrl, type Locale } from '../i18n/config';
import { getDict } from '../i18n';

interface Props {
  locale?: Locale;
  path?: string;
}

const { locale = DEFAULT_LOCALE, path = '/' } = Astro.props;
const t = getDict<any>(locale, 'chrome');
const pageLocales = PAGE_LOCALES[path] ?? [DEFAULT_LOCALE];
---
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div>
        <a href={navUrl(locale, '/')} class="brand-lockup" style="margin-bottom: 14px;">
          <img src="/assets/manilo-icon.svg" alt="" class="brand-icon" />
          <span class="brand-word brand-word--text">manilo</span>
        </a>
        <p class="site-footer__about">{t.footer.tagline}</p>
      </div>
      <div>
        <h4>{t.footer.product}</h4>
        <ul>
          <li><a href={navUrl(locale, '/')}>{t.footer.home}</a></li>
          <li><a href={`${DASHBOARD_URL}/upgrade`} target="_blank" rel="noopener noreferrer">{t.footer.pricing}</a></li>
          <li><a href={navUrl(locale, '/integrations')}>{t.footer.integrations}</a></li>
          <li><a href={navUrl(locale, '/chatgpt')}>{t.footer.chatgpt}</a></li>
          <li><a href={DASHBOARD_URL} target="_blank" rel="noopener noreferrer">{t.footer.openDashboard}</a></li>
          <li><a href={APP_STORE_URL} target="_blank" rel="noopener noreferrer">{t.footer.downloadAppStore}</a></li>
        </ul>
      </div>
      <div>
        <h4>{t.footer.developers}</h4>
        <ul>
          <li><a href={navUrl(locale, '/api-v1')}>{t.footer.apiRef}</a></li>
          <li><a href={navUrl(locale, '/integrations')}>{t.footer.mcp}</a></li>
        </ul>
      </div>
      <div>
        <h4>{t.footer.support}</h4>
        <ul>
          <li><a href={navUrl(locale, '/support')}>{t.footer.helpCenter}</a></li>
          <li><a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a></li>
        </ul>
      </div>
      <div>
        <h4>{t.footer.legal}</h4>
        <ul>
          <li><a href={navUrl(locale, '/privacy')}>{t.footer.privacy}</a></li>
          <li><a href={navUrl(locale, '/terms')}>{t.footer.terms}</a></li>
        </ul>
      </div>
    </div>
    {pageLocales.length > 1 && (
      <nav class="site-footer__langs" aria-label={t.footer.language}>
        {pageLocales.map((l) => (
          <a href={localeUrl(l, path)} hreflang={l} lang={l} aria-current={l === locale ? 'true' : undefined}>{LOCALE_NAMES[l]}</a>
        ))}
      </nav>
    )}
    <div class="site-footer__legal">
      <span>{t.footer.copyright}</span>
      <div class="site-footer__legal-links">
        <span class="pill pill--success" style="font-size:11px;"><span class="dot"></span> {t.footer.status}</span>
      </div>
    </div>
  </div>
</footer>
