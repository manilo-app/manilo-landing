---
import { APP_STORE_URL, DASHBOARD_URL } from '../consts';

const path = Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, '') || '/';
const active = (p: string) => (path === p ? 'page' : undefined);
---
<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand-lockup" aria-label="Manilo home">
      <img src="/assets/manilo-icon.svg" alt="" class="brand-icon" />
      <span class="brand-word brand-word--text">manilo</span>
    </a>
    <nav class="site-nav" aria-label="Primary">
      <a href="/" aria-current={active('/')}>Home</a>
      <a href={`${DASHBOARD_URL}/upgrade`} target="_blank" rel="noopener noreferrer">Pricing</a>
      <a href="/support" aria-current={active('/support')}>Support</a>
    </nav>
    <div class="site-header__cta">
      <a class="btn btn--ghost" href={DASHBOARD_URL} target="_blank" rel="noopener noreferrer">Open dashboard</a>
      <a class="btn btn--primary" href={APP_STORE_URL} target="_blank" rel="noopener noreferrer" data-cta="Download on App Store" data-cta-position="header">
        <i class="fa-brands fa-apple" aria-hidden="true"></i>
        Download on the App Store
      </a>
    </div>
  </div>
</header>
