---
import Base from '../../layouts/Base.astro';
import { navUrl, type Locale } from '../../i18n/config';
import { getDict } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = getDict<any>(lang, 'api');

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: d.jsonLd.breadcrumbHome, item: 'https://manilo.app/' },
    { '@type': 'ListItem', position: 2, name: d.jsonLd.breadcrumbApi, item: 'https://manilo.app/api-v1' },
  ],
};

const techArticleLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: d.jsonLd.headline,
  description: d.jsonLd.description,
  url: 'https://manilo.app/api-v1',
  inLanguage: lang,
  datePublished: '2026-05-19',
  dateModified: '2026-05-26',
  image: 'https://manilo.app/assets/og-image.png',
  author: { '@type': 'Person', name: 'Borys Harholinskyi' },
  publisher: {
    '@type': 'Organization',
    name: 'Manilo',
    logo: { '@type': 'ImageObject', url: 'https://manilo.app/assets/manilo-icon.svg' },
  },
  about: {
    '@type': 'MobileApplication',
    name: 'Manilo',
    operatingSystem: 'iOS 15.0',
    applicationCategory: 'FinanceApplication',
  },
  proficiencyLevel: 'Expert',
};
---
<Base
  title={d.meta.title}
  description={d.meta.description}
  path="/api-v1"
  locale={lang}
  ogDescription={d.meta.ogDescription}
  ogType="article"
  screenLabel="07 API v1 Reference"
  css={['/assets/doc.css']}
  js={['/assets/doc.js']}
>
<Fragment slot="head">
<meta name="twitter:title" content={d.meta.twitterTitle}>
<meta name="twitter:description" content={d.meta.twitterDescription}>
<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(techArticleLd)} />
</Fragment>

<section class="doc-hero">
  <div class="container">
    <span class="t-eyebrow">{d.hero.eyebrow}</span>
    <h1>{d.hero.title}</h1>
    <p class="doc-meta">
      <span><i class="fa-solid fa-code"></i> {d.hero.stack}</span>
      <span><i class="fa-solid fa-server"></i> <code>https://api.manilo.app</code></span>
      <span><i class="fa-solid fa-circle-check"></i> {d.hero.stability}</span>
    </p>
  </div>
</section>

<div class="container">
<div class="doc">
  <aside class="doc__toc doc__toc--collapsible" aria-label={d.toc.ariaLabel}>
    <h4>{d.toc.heading}</h4>
    <button class="doc__toc-toggle" type="button" aria-expanded="false" aria-controls="toc-list">
      <i class="fa-solid fa-bars"></i> {d.toc.toggle} <i class="fa-solid fa-chevron-down doc__toc-chev"></i>
    </button>
    <ol id="toc-list">
      <li class="toc-group">{d.toc.groups.gettingStarted}</li>
      <li><a href="#overview">{d.toc.items.overview}</a></li>
      <li><a href="#quickstart">{d.toc.items.quickstart}</a></li>
      <li><a href="#authentication">{d.toc.items.authentication}</a></li>
      <li><a href="#scopes">{d.toc.items.scopes}</a></li>
      <li><a href="#subscription">{d.toc.items.subscription}</a></li>

      <li class="toc-group">{d.toc.groups.conventions}</li>
      <li><a href="#errors">{d.toc.items.errors}</a></li>
      <li><a href="#pagination">{d.toc.items.pagination}</a></li>
      <li><a href="#types">{d.toc.items.types}</a></li>

      <li class="toc-group">{d.toc.groups.resources}</li>
      <li><a href="#accounts">{d.toc.items.accounts}</a></li>
      <li><a href="#categories">{d.toc.items.categories}</a></li>
      <li><a href="#budgets">{d.toc.items.budgets}</a></li>
      <li><a href="#groups">{d.toc.items.groups}</a></li>
      <li><a href="#transactions">{d.toc.items.transactions}</a></li>
      <li><a href="#icons">{d.toc.items.icons}</a></li>

      <li class="toc-group">{d.toc.groups.more}</li>
      <li><a href="#changelog">{d.toc.items.changelog}</a></li>
      <li><a href="#support">{d.toc.items.support}</a></li>
    </ol>
  </aside>

  <article class="doc__body">

    <!-- ============================================================
         OVERVIEW
         ============================================================ -->
    <section id="overview">
      <h2 data-num="01">{d.overview.title}</h2>
      <p>{d.overview.intro}</p>
      <ul>
        <li><strong>{d.overview.bullets.baseUrl.label}</strong> <code>https://api.manilo.app</code>{d.overview.bullets.baseUrl.t1}<code>api.ledgy.app</code>{d.overview.bullets.baseUrl.t2}</li>
        <li><strong>{d.overview.bullets.versionPrefix.label}</strong>{d.overview.bullets.versionPrefix.t1}<code>/api/v1/</code>{d.overview.bullets.versionPrefix.t2}</li>
        <li><strong>{d.overview.bullets.transport.label}</strong>{d.overview.bullets.transport.t1}</li>
        <li><strong>{d.overview.bullets.encoding.label}</strong>{d.overview.bullets.encoding.t1}<code>camelCase</code>{d.overview.bullets.encoding.t2}</li>
        <li><strong>{d.overview.bullets.auth.label}</strong> <code>Authorization: Bearer …</code>{d.overview.bullets.auth.t1}</li>
        <li><strong>{d.overview.bullets.subscription.label}</strong>{d.overview.bullets.subscription.t1}<a href="#subscription">{d.overview.bullets.subscription.link}</a>{d.overview.bullets.subscription.t2}</li>
      </ul>
      <div class="callout">
        <i class="fa-solid fa-flask"></i>
        <div>
          <strong>{d.overview.callout.strong}</strong>{d.overview.callout.t1}<code>https://api.manilo.app/mcp</code>{d.overview.callout.t2}<a href={navUrl(lang, '/integrations')}>{d.overview.callout.link}</a>{d.overview.callout.t3}
        </div>
      </div>
    </section>

    <!-- ============================================================
         QUICKSTART
         ============================================================ -->
    <section id="quickstart">
      <h2 data-num="02">{d.quickstart.title}</h2>
      <p>{d.quickstart.intro}</p>

      <h3>{d.quickstart.mintTitle}</h3>
      <ol>
        <li>{d.quickstart.steps.signIn.t1}<a href="https://dashboard.manilo.app" target="_blank" rel="noopener noreferrer">{d.quickstart.steps.signIn.link}</a>{d.quickstart.steps.signIn.t2}<strong>{d.quickstart.steps.signIn.strong}</strong>{d.quickstart.steps.signIn.t3}</li>
        <li>{d.quickstart.steps.newToken.t1}<strong>{d.quickstart.steps.newToken.strong}</strong>{d.quickstart.steps.newToken.t2}</li>
        <li>{d.quickstart.steps.nameIt.t1}<em>{d.quickstart.steps.nameIt.em}</em>{d.quickstart.steps.nameIt.t2}<a href="#scopes">{d.quickstart.steps.nameIt.link}</a>{d.quickstart.steps.nameIt.t3}</li>
        <li>{d.quickstart.steps.copyIt.t1}<em>{d.quickstart.steps.copyIt.em}</em>{d.quickstart.steps.copyIt.t2}<code>lgpat_</code>{d.quickstart.steps.copyIt.t3}</li>
      </ol>
      <p>{d.quickstart.tokensPage}</p>

      <h3>{d.quickstart.requestTitle}</h3>
      <div class="code-block">
        <div class="code-block__header"><span class="code-block__lang">cURL</span><span class="code-block__caption">{d.quickstart.curlCaption}</span></div>
<pre><span class="c-cmt"># Replace lgpat_… with your token</span>
curl <span class="c-str">"https://api.manilo.app/api/v1/accounts"</span> \
  -H <span class="c-str">"Authorization: Bearer lgpat_a1b2c3d4e5…"</span></pre>
      </div>

      <h3>{d.quickstart.responseTitle}</h3>
      <div class="code-block">
        <div class="code-block__header"><span class="code-block__lang">200 OK</span><span class="code-block__caption">application/json</span></div>
<pre is:raw>{
  <span class="c-key">"items"</span>: [
    {
      <span class="c-key">"id"</span>: <span class="c-str">"acc_01HK8V…"</span>,
      <span class="c-key">"name"</span>: <span class="c-str">"Wise EUR"</span>,
      <span class="c-key">"currencyCode"</span>: <span class="c-str">"EUR"</span>,
      <span class="c-key">"initialBalance"</span>: <span class="c-num">1240.50</span>,
      <span class="c-key">"icon"</span>: <span class="c-str">"wallet"</span>,
      <span class="c-key">"color"</span>: <span class="c-str">"#4A90E2"</span>,
      <span class="c-key">"order"</span>: <span class="c-num">0</span>,
      <span class="c-key">"createdAt"</span>: <span class="c-str">"2026-04-12T08:13:09Z"</span>,
      <span class="c-key">"updatedAt"</span>: <span class="c-str">"2026-05-01T17:02:31Z"</span>
    }
  ],
  <span class="c-key">"totalCount"</span>: <span class="c-num">1</span>
}</pre>
      </div>

      <div class="callout">
        <i class="fa-solid fa-shield-halved"></i>
        <div><strong>{d.quickstart.callout.strong1}</strong>{d.quickstart.callout.t1}<strong>{d.quickstart.callout.strong2}</strong>{d.quickstart.callout.t2}</div>
      </div>
    </section>

    <!-- ============================================================
         AUTHENTICATION
         ============================================================ -->
    <section id="authentication">
      <h2 data-num="03">{d.authentication.title}</h2>
      <p>{d.authentication.intro.t1}<code>/api/v1/</code>{d.authentication.intro.t2}<code>Authorization</code>{d.authentication.intro.t3}</p>
      <ul>
        <li><strong>{d.authentication.pat.strong1}</strong>{d.authentication.pat.t1}<strong>{d.authentication.pat.strong2}</strong>{d.authentication.pat.t2}<code>lgpat_</code>{d.authentication.pat.t3}<strong>{d.authentication.pat.strong3}</strong></li>
        <li><strong>{d.authentication.jwt.strong}</strong>{d.authentication.jwt.t1}</li>
      </ul>

      <h3>{d.authentication.headerTitle}</h3>
      <div class="code-block">
        <div class="code-block__header"><span class="code-block__lang">HTTP</span></div>
<pre>Authorization: Bearer lgpat_a1b2c3d4e5f6…</pre>
      </div>

      <h3>{d.authentication.limitsTitle}</h3>
      <ul>
        <li>{d.authentication.limits.count.t1}<strong>{d.authentication.limits.count.strong}</strong>{d.authentication.limits.count.t2}</li>
        <li>{d.authentication.limits.expiry.t1}<code>401 Unauthorized</code>{d.authentication.limits.expiry.t2}</li>
        <li>{d.authentication.limits.revoked}</li>
      </ul>

      <h3>{d.authentication.failuresTitle}</h3>
      <dl class="status-grid">
        <dt class="s4xx">401</dt><dd>{d.authentication.failures.s401}</dd>
        <dt class="s4xx">403</dt><dd>{d.authentication.failures.s403}</dd>
      </dl>
    </section>

    <!-- ============================================================
         SCOPES
         ============================================================ -->
    <section id="scopes">
      <h2 data-num="04">{d.scopes.title}</h2>
      <p>{d.scopes.intro.t1}<strong>{d.scopes.intro.strong}</strong>{d.scopes.intro.t2}<code>403 Forbidden</code>{d.scopes.intro.t3}</p>

      <p>{d.scopes.available}</p>
      <div class="scope-list">
        <code>accounts:read</code>
        <code>accounts:write</code>
        <code>categories:read</code>
        <code>categories:write</code>
        <code>budgets:read</code>
        <code>budgets:write</code>
        <code>groups:read</code>
        <code>groups:write</code>
        <code>transactions:read</code>
        <code>transactions:write</code>
        <code>tags:read</code>
        <code>tags:write</code>
        <code>recurring:read</code>
        <code>recurring:write</code>
        <code>settings:read</code>
        <code>settings:write</code>
      </div>
      <p>{d.scopes.chips.t1}<em>:write</em>{d.scopes.chips.t2}<em>:read</em>{d.scopes.chips.t3}</p>
    </section>

    <!-- ============================================================
         SUBSCRIPTION GATE
         ============================================================ -->
    <section id="subscription">
      <h2 data-num="05">{d.subscription.title}</h2>
      <p>{d.subscription.intro.t1}<strong>{d.subscription.intro.strong}</strong>{d.subscription.intro.t2}</p>
      <div class="code-block">
        <div class="code-block__header"><span class="code-block__lang">403 Forbidden</span></div>
<pre is:raw>HTTP/1.1 403 Forbidden
X-Subscription-Required: true
Content-Type: application/json

{ <span class="c-key">"error"</span>: <span class="c-str">"Active cloud subscription required"</span> }</pre>
      </div>
      <p>{d.subscription.outro.t1}<code>X-Subscription-Required</code>{d.subscription.outro.t2}<a href="https://dashboard.manilo.app/upgrade" target="_blank" rel="noopener noreferrer">dashboard.manilo.app/upgrade</a>{d.subscription.outro.t3}</p>
    </section>

    <!-- ============================================================
         ERRORS
         ============================================================ -->
    <section id="errors">
      <h2 data-num="06">{d.errors.title}</h2>
      <p>{d.errors.intro}</p>
      <div class="code-block">
        <div class="code-block__header"><span class="code-block__lang">JSON</span></div>
<pre is:raw>{ <span class="c-key">"error"</span>: <span class="c-str">"Human-readable message"</span> }</pre>
      </div>
      <p>{d.errors.handle}</p>
      <dl class="status-grid">
        <dt class="s2xx">200</dt><dd>{d.errors.statuses.s200}</dd>
        <dt class="s2xx">201</dt><dd>{d.errors.statuses.s201.t1}<code>Location</code>{d.errors.statuses.s201.t2}</dd>
        <dt class="s2xx">204</dt><dd>{d.errors.statuses.s204}</dd>
        <dt class="s4xx">400</dt><dd>{d.errors.statuses.s400}</dd>
        <dt class="s4xx">401</dt><dd>{d.errors.statuses.s401.t1}<a href="#authentication">{d.errors.statuses.s401.link}</a>{d.errors.statuses.s401.t2}</dd>
        <dt class="s4xx">403</dt><dd>{d.errors.statuses.s403}</dd>
        <dt class="s4xx">404</dt><dd>{d.errors.statuses.s404}</dd>
        <dt class="s4xx">409</dt><dd>{d.errors.statuses.s409}</dd>
        <dt class="s5xx">5xx</dt><dd>{d.errors.statuses.s5xx}</dd>
      </dl>
    </section>

    <!-- ============================================================
         PAGINATION & FILTERS
         ============================================================ -->
    <section id="pagination">
      <h2 data-num="07">{d.pagination.title}</h2>
      <p>{d.pagination.intro}</p>

      <h3>{d.pagination.cursorTitle}</h3>
      <div class="code-block">
        <div class="code-block__header"><span class="code-block__lang">cURL</span><span class="code-block__caption">{d.pagination.caption}</span></div>
<pre>curl <span class="c-str">"https://api.manilo.app/api/v1/transactions?limit=50&amp;type=expense&amp;dateFrom=2026-01-01"</span> \
  -H <span class="c-str">"Authorization: Bearer lgpat_…"</span></pre>
      </div>
      <p>{d.pagination.response.t1}<code>nextCursor</code>{d.pagination.response.t2}<code>cursor</code>{d.pagination.response.t3}<code>nextCursor</code>{d.pagination.response.t4}<code>null</code>{d.pagination.response.t5}</p>
      <ul>
        <li><code>limit</code>{d.pagination.params.limit.t1}<code>1..200</code>{d.pagination.params.limit.t2}<code>50</code>{d.pagination.params.limit.t3}</li>
        <li><code>cursor</code>{d.pagination.params.cursor}</li>
        <li><code>type</code>, <code>dateFrom</code>, <code>dateTo</code>, <code>categoryId</code>, <code>accountId</code>, <code>groupId</code>{d.pagination.params.filters.t1}<a href="#tx-list">{d.pagination.params.filters.link}</a>{d.pagination.params.filters.t2}</li>
      </ul>
    </section>

    <!-- ============================================================
         TYPES & FORMATS
         ============================================================ -->
    <section id="types">
      <h2 data-num="08">{d.types.title}</h2>
      <ul>
        <li><strong>{d.types.ids.strong}</strong>{d.types.ids.t1}</li>
        <li><strong>{d.types.timestamps.strong}</strong>{d.types.timestamps.t1}<code>Z</code>{d.types.timestamps.t2}<code>"2026-05-13T10:30:00Z"</code>{d.types.timestamps.t3}</li>
        <li><strong>{d.types.dates.strong}</strong>{d.types.dates.t1}<code>date</code>{d.types.dates.t2}</li>
        <li><strong>{d.types.money.strong1}</strong>{d.types.money.t1}<strong>{d.types.money.strong2}</strong>{d.types.money.t2}<code>12.50</code>{d.types.money.t3}<code>currencyCode</code>{d.types.money.t4}</li>
        <li><strong>{d.types.currencyCodes.strong}</strong>{d.types.currencyCodes.t1}<code>"EUR"</code>, <code>"USD"</code>, <code>"GBP"</code>{d.types.currencyCodes.t2}</li>
        <li><strong>{d.types.deletes.strong1}</strong>{d.types.deletes.t1}<strong>{d.types.deletes.strong2}</strong>{d.types.deletes.t2}</li>
        <li><strong>{d.types.sideEffects.strong}</strong>{d.types.sideEffects.t1}<a href="#acc-delete">{d.types.sideEffects.link}</a>{d.types.sideEffects.t2}</li>
      </ul>
    </section>

    <!-- ============================================================
         ACCOUNTS
         ============================================================ -->
    <section id="accounts">
      <h2 data-num="09">{d.accounts.title}</h2>
      <p class="resource-intro">{d.accounts.intro}</p>

      <!-- LIST -->
      <div class="endpoint" id="acc-list">
        <div class="endpoint__head">
          <span class="method-badge method-badge--get">GET</span>
          <code class="endpoint__path">/api/v1/accounts</code>
          <span class="endpoint__scope">accounts:read</span>
          <p class="endpoint__desc">{d.accounts.list.desc}</p>
        </div>
      </div>

      <!-- GET -->
      <div class="endpoint" id="acc-get">
        <div class="endpoint__head">
          <span class="method-badge method-badge--get">GET</span>
          <code class="endpoint__path">/api/v1/accounts/<span class="var" is:raw>{id}</span></code>
          <span class="endpoint__scope">accounts:read</span>
          <p class="endpoint__desc">{d.accounts.get.desc.t1}<code>404</code>{d.accounts.get.desc.t2}</p>
        </div>
      </div>

      <!-- CREATE -->
      <div class="endpoint" id="acc-create">
        <div class="endpoint__head">
          <span class="method-badge method-badge--post">POST</span>
          <code class="endpoint__path">/api/v1/accounts</code>
          <span class="endpoint__scope">accounts:write</span>
          <p class="endpoint__desc">{d.accounts.create.desc.t1}<code>201</code>{d.accounts.create.desc.t2}<code>Location</code>{d.accounts.create.desc.t3}</p>
        </div>
        <div class="params">
          <span class="params__title">{d.common.requestBody}</span>
          <table class="params-table">
            <thead><tr><th>{d.common.field}</th><th>{d.common.type}</th><th>{d.common.description}</th></tr></thead>
            <tbody>
              <tr><td class="name">name</td><td class="type">string</td><td class="desc"><span class="tag req">{d.common.required}</span>{d.accounts.create.fields.name}</td></tr>
              <tr><td class="name">currencyCode</td><td class="type">string</td><td class="desc"><span class="tag req">{d.common.required}</span>{d.accounts.create.fields.currencyCode}</td></tr>
              <tr><td class="name">initialBalance</td><td class="type">number</td><td class="desc"><span class="tag req">{d.common.required}</span>{d.accounts.create.fields.initialBalance.t1}<code>currencyCode</code>{d.accounts.create.fields.initialBalance.t2}</td></tr>
              <tr><td class="name">order</td><td class="type">integer</td><td class="desc"><span class="tag req">{d.common.required}</span>{d.accounts.create.fields.order}</td></tr>
              <tr><td class="name">icon</td><td class="type">string</td><td class="desc"><span class="tag opt">{d.common.optional}</span>{d.accounts.create.fields.icon.t1}<a href="#icons">/api/v1/icons</a>{d.accounts.create.fields.icon.t2}</td></tr>
              <tr><td class="name">color</td><td class="type">string</td><td class="desc"><span class="tag opt">{d.common.optional}</span>{d.accounts.create.fields.color.t1}<code>"#4A90E2"</code>{d.accounts.create.fields.color.t2}</td></tr>
              <tr><td class="name">iconColor</td><td class="type">string</td><td class="desc"><span class="tag opt">{d.common.optional}</span>{d.accounts.create.fields.iconColor}</td></tr>
            </tbody>
          </table>
        </div>
        <div class="code-pair">
          <div class="code-block">
            <div class="code-block__header"><span class="code-block__lang">{d.common.requestLabel}</span></div>
<pre is:raw>POST /api/v1/accounts
{
  <span class="c-key">"name"</span>: <span class="c-str">"Cash"</span>,
  <span class="c-key">"currencyCode"</span>: <span class="c-str">"EUR"</span>,
  <span class="c-key">"initialBalance"</span>: <span class="c-num">50.00</span>,
  <span class="c-key">"order"</span>: <span class="c-num">2</span>,
  <span class="c-key">"icon"</span>: <span class="c-str">"wallet"</span>,
  <span class="c-key">"color"</span>: <span class="c-str">"#22C55E"</span>
}</pre>
          </div>
          <div class="code-block">
            <div class="code-block__header"><span class="code-block__lang">201 Created</span></div>
<pre is:raw>{
  <span class="c-key">"id"</span>: <span class="c-str">"acc_01HK8V…"</span>,
  <span class="c-key">"name"</span>: <span class="c-str">"Cash"</span>,
  <span class="c-key">"currencyCode"</span>: <span class="c-str">"EUR"</span>,
  <span class="c-key">"initialBalance"</span>: <span class="c-num">50.00</span>,
  <span class="c-key">"order"</span>: <span class="c-num">2</span>,
  <span class="c-key">"icon"</span>: <span class="c-str">"wallet"</span>,
  <span class="c-key">"color"</span>: <span class="c-str">"#22C55E"</span>,
  <span class="c-key">"iconColor"</span>: <span class="c-null">null</span>,
  <span class="c-key">"shareInviteToken"</span>: <span class="c-null">null</span>,
  <span class="c-key">"createdAt"</span>: <span class="c-str">"2026-05-13T10:30:00Z"</span>,
  <span class="c-key">"updatedAt"</span>: <span class="c-str">"2026-05-13T10:30:00Z"</span>
}</pre>
          </div>
        </div>
      </div>

      <!-- UPDATE -->
      <div class="endpoint" id="acc-update">
        <div class="endpoint__head">
          <span class="method-badge method-badge--put">PUT</span>
          <code class="endpoint__path">/api/v1/accounts/<span class="var" is:raw>{id}</span></code>
          <span class="endpoint__scope">accounts:write</span>
          <p class="endpoint__desc">{d.accounts.update.desc.t1}<a href="#acc-create">{d.accounts.update.desc.link}</a>{d.accounts.update.desc.t2}</p>
        </div>
      </div>

      <!-- DELETE -->
      <div class="endpoint" id="acc-delete">
        <div class="endpoint__head">
          <span class="method-badge method-badge--delete">DELETE</span>
