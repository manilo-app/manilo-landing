          <span class="method-badge method-badge--get">GET</span>
          <code class="endpoint__path">/api/v1/icons</code>
          <p class="endpoint__desc">{d.icons.list.desc.t1}<code>version</code>{d.icons.list.desc.t2}</p>
        </div>
        <div class="code-block">
          <div class="code-block__header"><span class="code-block__lang">200 OK</span></div>
<pre is:raw>{
  <span class="c-key">"version"</span>: <span class="c-str">"2026.05.10"</span>,
