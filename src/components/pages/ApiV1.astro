  <span class="c-key">"note"</span>: <span class="c-str">"Flat white"</span>
}</pre>
        </div>
      </div>

      <!-- UPDATE -->
      <div class="endpoint" id="tx-update">
        <div class="endpoint__head">
          <span class="method-badge method-badge--put">PUT</span>
          <code class="endpoint__path">/api/v1/transactions/<span class="var" is:raw>{id}</span></code>
          <span class="endpoint__scope">transactions:write</span>
          <p class="endpoint__desc">{d.transactions.update.desc.t1}<a href="#tx-create">{d.transactions.update.desc.link}</a>{d.transactions.update.desc.t2}</p>
        </div>
      </div>

      <!-- DELETE -->
      <div class="endpoint" id="tx-delete">
        <div class="endpoint__head">
          <span class="method-badge method-badge--delete">DELETE</span>
          <code class="endpoint__path">/api/v1/transactions/<span class="var" is:raw>{id}</span></code>
          <span class="endpoint__scope">transactions:write</span>
          <p class="endpoint__desc">{d.transactions.delete.desc}</p>
        </div>
      </div>

      <!-- TRANSFER -->
      <div class="endpoint" id="tx-transfer">
        <div class="endpoint__head">
          <span class="method-badge method-badge--post">POST</span>
          <code class="endpoint__path">/api/v1/transactions/transfer</code>
          <span class="endpoint__scope">transactions:write</span>
          <p class="endpoint__desc">{d.transactions.transfer.desc.t1}<code>exchangeRate</code>{d.transactions.transfer.desc.t2}<code>convertedAmount</code>{d.transactions.transfer.desc.t3}</p>
        </div>
        <div class="params">
          <span class="params__title">{d.common.requestBody}</span>
          <table class="params-table">
            <thead><tr><th>{d.common.field}</th><th>{d.common.type}</th><th>{d.common.description}</th></tr></thead>
            <tbody>
              <tr><td class="name">fromAccountId</td><td class="type">string</td><td class="desc"><span class="tag req">{d.common.required}</span>{d.transactions.transfer.fields.fromAccountId}</td></tr>
              <tr><td class="name">toAccountId</td><td class="type">string</td><td class="desc"><span class="tag req">{d.common.required}</span>{d.transactions.transfer.fields.toAccountId}</td></tr>
              <tr><td class="name">amount</td><td class="type">number</td><td class="desc"><span class="tag req">{d.common.required}</span>{d.transactions.transfer.fields.amount.t1}<code>currencyCode</code>{d.transactions.transfer.fields.amount.t2}</td></tr>
              <tr><td class="name">currencyCode</td><td class="type">string</td><td class="desc"><span class="tag req">{d.common.required}</span>{d.transactions.transfer.fields.currencyCode}</td></tr>
              <tr><td class="name">date</td><td class="type">string (ISO-8601)</td><td class="desc"><span class="tag req">{d.common.required}</span>{d.transactions.transfer.fields.date}</td></tr>
              <tr><td class="name">exchangeRate</td><td class="type">number</td><td class="desc"><span class="tag opt">{d.common.optional}</span>{d.transactions.transfer.fields.exchangeRate}</td></tr>
              <tr><td class="name">convertedAmount</td><td class="type">number</td><td class="desc"><span class="tag opt">{d.common.optional}</span>{d.transactions.transfer.fields.convertedAmount}</td></tr>
              <tr><td class="name">note</td><td class="type">string</td><td class="desc"><span class="tag opt">{d.common.optional}</span>{d.transactions.transfer.fields.note}</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <h3>{d.transactions.bulkTitle}</h3>
      <p>{d.transactions.bulkIntro.t1}<strong>{d.transactions.bulkIntro.strong1}</strong>{d.transactions.bulkIntro.t2}<strong>{d.transactions.bulkIntro.strong2}</strong>{d.transactions.bulkIntro.t3}</p>

      <div class="endpoint" id="tx-bulk-create">
        <div class="endpoint__head">
          <span class="method-badge method-badge--post">POST</span>
          <code class="endpoint__path">/api/v1/transactions/bulk</code>
          <span class="endpoint__scope">transactions:write</span>
          <p class="endpoint__desc">{d.transactions.bulkCreate.desc}</p>
        </div>
        <div class="code-block">
          <div class="code-block__header"><span class="code-block__lang">200 OK</span></div>
<pre is:raw>{
  <span class="c-key">"items"</span>: [ <span class="c-cmt">/* successful TransactionDto[] */</span> ],
  <span class="c-key">"errors"</span>: [
    { <span class="c-key">"index"</span>: <span class="c-num">3</span>, <span class="c-key">"error"</span>: <span class="c-str">"Invalid currency code"</span> }
  ]
}</pre>
        </div>
      </div>

      <div class="endpoint" id="tx-bulk-update">
        <div class="endpoint__head">
          <span class="method-badge method-badge--put">PUT</span>
          <code class="endpoint__path">/api/v1/transactions/bulk</code>
          <span class="endpoint__scope">transactions:write</span>
          <p class="endpoint__desc">{d.transactions.bulkUpdate.desc.t1}<code>id</code>{d.transactions.bulkUpdate.desc.t2}</p>
        </div>
      </div>

      <div class="endpoint" id="tx-bulk-delete">
        <div class="endpoint__head">
          <span class="method-badge method-badge--post">POST</span>
          <code class="endpoint__path">/api/v1/transactions/bulk-delete</code>
          <span class="endpoint__scope">transactions:write</span>
          <p class="endpoint__desc">{d.transactions.bulkDelete.desc.t1}<code>POST</code>{d.transactions.bulkDelete.desc.t2}<code>DELETE</code>{d.transactions.bulkDelete.desc.t3}</p>
        </div>
        <div class="params">
          <span class="params__title">{d.common.requestBody}</span>
          <table class="params-table">
            <thead><tr><th>{d.common.field}</th><th>{d.common.type}</th><th>{d.common.description}</th></tr></thead>
            <tbody>
              <tr><td class="name">ids</td><td class="type">string[]</td><td class="desc"><span class="tag req">{d.common.required}</span>{d.transactions.bulkDelete.fields.ids}</td></tr>
            </tbody>
          </table>
        </div>
        <div class="code-block">
          <div class="code-block__header"><span class="code-block__lang">200 OK</span></div>
<pre is:raw>{
  <span class="c-key">"deleted"</span>: <span class="c-num">97</span>,
  <span class="c-key">"notFound"</span>: [ <span class="c-str">"tx_old1"</span>, <span class="c-str">"tx_old2"</span>, <span class="c-str">"tx_old3"</span> ]
}</pre>
        </div>
      </div>

      <h3>{d.transactions.objectTitle}</h3>
      <table class="params-table">
        <thead><tr><th>{d.common.field}</th><th>{d.common.type}</th><th>{d.common.description}</th></tr></thead>
        <tbody>
          <tr><td class="name">id</td><td class="type">string</td><td class="desc">{d.transactions.object.id}</td></tr>
          <tr><td class="name">type</td><td class="type">string</td><td class="desc"><code>income</code> · <code>expense</code> · <code>transfer</code> · <code>adjustment</code>.</td></tr>
          <tr><td class="name">amount</td><td class="type">number</td><td class="desc">{d.transactions.object.amount.t1}<code>currencyCode</code>{d.transactions.object.amount.t2}</td></tr>
          <tr><td class="name">currencyCode</td><td class="type">string</td><td class="desc">{d.transactions.object.currencyCode}</td></tr>
          <tr><td class="name">exchangeRate</td><td class="type">number | null</td><td class="desc">{d.transactions.object.exchangeRate}</td></tr>
          <tr><td class="name">convertedAmount</td><td class="type">number | null</td><td class="desc">{d.transactions.object.convertedAmount}</td></tr>
          <tr><td class="name">date</td><td class="type">string</td><td class="desc">{d.transactions.object.date}</td></tr>
          <tr><td class="name">accountId</td><td class="type">string | null</td><td class="desc">{d.transactions.object.accountId}</td></tr>
          <tr><td class="name">toAccountId</td><td class="type">string | null</td><td class="desc">{d.transactions.object.toAccountId}</td></tr>
          <tr><td class="name">categoryId</td><td class="type">string | null</td><td class="desc">{d.transactions.object.categoryId}</td></tr>
          <tr><td class="name">groupId</td><td class="type">string | null</td><td class="desc">{d.transactions.object.groupId}</td></tr>
          <tr><td class="name">payee</td><td class="type">string | null</td><td class="desc">{d.transactions.object.payee}</td></tr>
          <tr><td class="name">note</td><td class="type">string | null</td><td class="desc">{d.transactions.object.note}</td></tr>
          <tr><td class="name">receiptImagePath</td><td class="type">string | null</td><td class="desc">{d.transactions.object.receiptImagePath}</td></tr>
          <tr><td class="name">recurringTransactionId</td><td class="type">string | null</td><td class="desc">{d.transactions.object.recurringTransactionId}</td></tr>
          <tr><td class="name">source</td><td class="type">string</td><td class="desc">{d.transactions.object.source.t1}<code>api</code>, <code>mobile</code>, <code>web</code>, <code>import</code>{d.transactions.object.source.t2}</td></tr>
          <tr><td class="name">createdAt</td><td class="type">string</td><td class="desc">{d.transactions.object.createdAt}</td></tr>
          <tr><td class="name">updatedAt</td><td class="type">string</td><td class="desc">{d.transactions.object.updatedAt}</td></tr>
        </tbody>
      </table>
    </section>

    <!-- ============================================================
         ICONS
         ============================================================ -->
