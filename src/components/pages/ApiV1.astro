  ]
}</pre>
        </div>
      </div>
    </section>

    <!-- ============================================================
         CHANGELOG / VERSIONING
         ============================================================ -->
    <section id="changelog">
      <h2 data-num="15">{d.versioning.title}</h2>
      <ul>
        <li><strong>{d.versioning.noBreaking.strong}</strong>{d.versioning.noBreaking.t1}</li>
        <li><strong>{d.versioning.enums.strong}</strong>{d.versioning.enums.t1}<code>type</code>, <code>source</code>{d.versioning.enums.t2}<code>action</code>{d.versioning.enums.t3}<em>{d.versioning.enums.em}</em>{d.versioning.enums.t4}</li>
        <li><strong>{d.versioning.v2.strong}</strong>{d.versioning.v2.t1}<code>/api/v2/</code>{d.versioning.v2.t2}</li>
      </ul>
    </section>

    <!-- ============================================================
         SUPPORT
         ============================================================ -->
    <section id="support">
      <h2 data-num="16">{d.support.title}</h2>
      <p>{d.support.p1.t1}<a href={navUrl(lang, '/support')}>{d.support.p1.link}</a>{d.support.p1.t2}<a href="mailto:support@manilo.app">support@manilo.app</a>{d.support.p1.t3}<code>X-Request-Id</code>{d.support.p1.t4}</p>
      <p>{d.support.p2.t1}<a href="mailto:security@manilo.app">security@manilo.app</a>{d.support.p2.t2}</p>
    </section>

  </article>
</div>
</div>
