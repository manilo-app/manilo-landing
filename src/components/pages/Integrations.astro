<script is:inline>
// Assistant picker — accessible tabs with hash deep-links and copy buttons.
(function () {
  var tabs = Array.prototype.slice.call(document.querySelectorAll(".ig-tab"));
  if (!tabs.length) return;
  var panels = {};
  tabs.forEach(function (t) { panels[t.dataset.assistant] = document.getElementById("panel-" + t.dataset.assistant); });
  // Old section ids from the previous version of this page.
  var LEGACY = { "quick-start-chatgpt": "chatgpt", "quick-start": "claude", "other-clients": "other" };

  function select(key, opts) {
    opts = opts || {};
    if (!panels[key]) return;
    tabs.forEach(function (t) {
      var on = t.dataset.assistant === key;
      t.setAttribute("aria-selected", String(on));
      t.tabIndex = on ? 0 : -1;
      panels[t.dataset.assistant].classList.toggle("is-active", on);
    });
    if (opts.updateHash && history.replaceState) history.replaceState(null, "", "#" + key);
    if (opts.track) {
      var evt = { assistant: key, page: location.pathname };
      if (window.plausible) window.plausible("assistant_select", { props: evt });
      if (window.gtag) window.gtag("event", "assistant_select", evt);
    }
  }

  tabs.forEach(function (t, i) {
    t.addEventListener("click", function () { select(t.dataset.assistant, { updateHash: true, track: true }); });
    t.addEventListener("keydown", function (e) {
      var next = null;
      if (e.key === "ArrowRight" || e.key === "ArrowDown") next = (i + 1) % tabs.length;
      else if (e.key === "ArrowLeft" || e.key === "ArrowUp") next = (i - 1 + tabs.length) % tabs.length;
      else if (e.key === "Home") next = 0;
      else if (e.key === "End") next = tabs.length - 1;
      if (next === null) return;
      e.preventDefault();
      tabs[next].focus();
      select(tabs[next].dataset.assistant, { updateHash: true });
    });
  });

  function fromHash(scroll) {
    var h = decodeURIComponent(location.hash.slice(1));
    var key = panels[h] ? h : LEGACY[h];
    if (!key) return false;
    select(key);
    if (scroll) {
      var picker = document.getElementById("picker");
      if (picker) requestAnimationFrame(function () { picker.scrollIntoView({ block: "start" }); });
    }
    return true;
  }
  if (!fromHash(true)) select("chatgpt");
  window.addEventListener("hashchange", function () { fromHash(false); });

  // Copy-to-clipboard for the MCP server URL.
  document.querySelectorAll("[data-copy]").forEach(function (btn) {
    var icon = btn.querySelector("i");
    var label = btn.querySelector("span");
    btn.addEventListener("click", function () {
      var done = function () {
        btn.classList.add("is-copied");
        if (icon) icon.className = "fa-solid fa-check";
        if (label) label.textContent = "Copied";
        setTimeout(function () {
          btn.classList.remove("is-copied");
          if (icon) icon.className = "fa-regular fa-copy";
          if (label) label.textContent = "Copy";
        }, 1600);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(btn.dataset.copy).then(done, done);
      } else {
        done();
      }
    });
  });
})();
</script>
